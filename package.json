{
  "name": "klein-sdk",
  "version": "0.1.0",
  "description": "Framework-independent SDK for Klein classroom math tools.",
  "keywords": [
    "math",
    "geometry",
    "whiteboard",
    "graphing",
    "sdk"
  ],
  "author": "",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "files": [
    "dist",
    "apps",
    "fixtures",
    "docs/ASSESSMENT_CONTRACT_V1.md",
    "docs/V0_API.md",
    "integrations",
    "GEOGEBRA_V0_SDK_IMPLEMENTATION_PLAN.md",
    "V0_DEPLOYMENT_CHECKLIST.md",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./core": {
      "types": "./dist/core/index.d.ts",
      "import": "./dist/core/index.js"
    },
    "./theme": {
      "types": "./dist/theme/index.d.ts",
      "import": "./dist/theme/index.js"
    },
    "./math": {
      "types": "./dist/math/index.d.ts",
      "import": "./dist/math/index.js"
    },
    "./geometry-core": {
      "types": "./dist/geometry-core/index.d.ts",
      "import": "./dist/geometry-core/index.js"
    },
    "./whiteboard": {
      "types": "./dist/whiteboard/index.d.ts",
      "import": "./dist/whiteboard/index.js"
    },
    "./geometry": {
      "types": "./dist/geometry/index.d.ts",
      "import": "./dist/geometry/index.js"
    },
    "./geometry-lab": {
      "types": "./dist/geometry-lab/index.d.ts",
      "import": "./dist/geometry-lab/index.js"
    },
    "./graphing": {
      "types": "./dist/graphing/index.d.ts",
      "import": "./dist/graphing/index.js"
    },
    "./graphing-3d": {
      "types": "./dist/graphing-3d/index.d.ts",
      "import": "./dist/graphing-3d/index.js"
    },
    "./algebra": {
      "types": "./dist/algebra/index.d.ts",
      "import": "./dist/algebra/index.js"
    },
    "./calculator": {
      "types": "./dist/calculator/index.d.ts",
      "import": "./dist/calculator/index.js"
    },
    "./scientific": {
      "types": "./dist/scientific/index.d.ts",
      "import": "./dist/scientific/index.js"
    },
    "./probability": {
      "types": "./dist/probability/index.d.ts",
      "import": "./dist/probability/index.js"
    },
    "./tools": {
      "types": "./dist/tools/index.d.ts",
      "import": "./dist/tools/index.js"
    },
    "./spreadsheet": {
      "types": "./dist/spreadsheet/index.d.ts",
      "import": "./dist/spreadsheet/index.js"
    },
    "./workspace": {
      "types": "./dist/workspace/index.d.ts",
      "import": "./dist/workspace/index.js"
    },
    "./classroom": {
      "types": "./dist/classroom/index.d.ts",
      "import": "./dist/classroom/index.js"
    },
    "./exam": {
      "types": "./dist/exam/index.d.ts",
      "import": "./dist/exam/index.js"
    },
    "./assessment": {
      "types": "./dist/assessment/index.d.ts",
      "import": "./dist/assessment/index.js"
    },
    "./assessment/fixtures/*": "./fixtures/assessment/v1/*",
    "./persistence": {
      "types": "./dist/persistence/index.d.ts",
      "import": "./dist/persistence/index.js"
    },
    "./collab": {
      "types": "./dist/collab/index.d.ts",
      "import": "./dist/collab/index.js"
    },
    "./dom": {
      "types": "./dist/dom/index.d.ts",
      "import": "./dist/dom/index.js"
    },
    "./embed": {
      "types": "./dist/embed/index.d.ts",
      "import": "./dist/embed/index.js"
    },
    "./integrations": {
      "types": "./dist/integrations/index.d.ts",
      "import": "./dist/integrations/index.js"
    },
    "./integrations/teams": {
      "types": "./dist/integrations/teams/index.d.ts",
      "import": "./dist/integrations/teams/index.js"
    },
    "./integrations/google-classroom": {
      "types": "./dist/integrations/google-classroom/index.d.ts",
      "import": "./dist/integrations/google-classroom/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run typecheck",
    "test:graphing": "npm run build && node scripts/graphing-smoke.mjs",
    "test:collab": "npm run build && node --test tests/collab/*.test.mjs && node scripts/collab-reliability-smoke.mjs",
    "test:geometry-lab": "npm run build && node --expose-gc --test tests/geometry-lab/*.test.mjs",
    "bench:geometry-lab": "npm run build && node --expose-gc scripts/geometry-lab-bench.mjs",
    "bench:geometry-lab:check": "npm run build && node --expose-gc scripts/geometry-lab-bench.mjs --check",
    "bench:geometry-lab:update": "npm run build && node --expose-gc scripts/geometry-lab-bench.mjs --update-baseline",
    "test:assessment": "npm run build && node --test tests/assessment/*.test.mjs",
    "test:phase6": "npm run build && node scripts/phase6-smoke.mjs",
    "test:phase7": "npm run build && node scripts/phase7-smoke.mjs",
    "test:phase8": "npm run build && node scripts/phase8-smoke.mjs",
    "test:v0": "npm run build && node scripts/geogebra-v0-smoke.mjs && node scripts/collab-reliability-smoke.mjs",
    "test:ci": "npm run typecheck && npm run build && node --expose-gc --test tests/assessment/*.test.mjs tests/collab/*.test.mjs tests/geometry-lab/*.test.mjs tests/math/*.test.mjs && node scripts/geogebra-v0-smoke.mjs && node scripts/collab-reliability-smoke.mjs && node scripts/graphing-smoke.mjs",
    "pack:local": "npm pack",
    "test:math": "npm run build && node --test tests/math/*.test.mjs"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
