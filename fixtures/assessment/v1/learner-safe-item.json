{
  "kind": "learner_safe_assessment_item",
  "schemaVersion": 1,
  "itemId": "item-quadratic-context",
  "itemVersion": 3,
  "itemInstanceId": "item-instance-demo-001",
  "sequence": 1,
  "locale": "ro-RO",
  "title": "Interpretarea unei funcții pătratice",
  "contentBlocks": [
    {
      "id": "block-paragraph",
      "schemaVersion": 1,
      "type": "paragraph",
      "locale": "ro-RO",
      "text": "Citește cerințele și răspunde în spațiile indicate."
    },
    {
      "id": "block-heading",
      "schemaVersion": 1,
      "type": "heading",
      "locale": "ro-RO",
      "level": 2,
      "text": "Datele problemei"
    },
    {
      "id": "block-list",
      "schemaVersion": 1,
      "type": "list",
      "locale": "ro-RO",
      "style": "unordered",
      "items": [
        "Alege toate afirmațiile adevărate.",
        "Justifică răspunsul final."
      ]
    },
    {
      "id": "block-table",
      "schemaVersion": 1,
      "type": "table",
      "locale": "ro-RO",
      "caption": "Valori observate",
      "headers": [
        "x",
        "f(x)"
      ],
      "rows": [
        [
          "0",
          "0"
        ],
        [
          "2",
          "4"
        ]
      ]
    },
    {
      "id": "block-inline-math",
      "schemaVersion": 1,
      "type": "inline_math",
      "locale": "ro-RO",
      "latex": "f(x)=x^2",
      "accessibleText": "f de x este egal cu x la pătrat"
    },
    {
      "id": "block-display-math",
      "schemaVersion": 1,
      "type": "display_math",
      "locale": "ro-RO",
      "latex": "\\int_0^2 x\\,dx",
      "accessibleText": "integrala de la zero la doi din x d x"
    },
    {
      "id": "block-image",
      "schemaVersion": 1,
      "type": "image",
      "locale": "ro-RO",
      "assetId": "asset-parabola-diagram",
      "altText": "Graficul unei parabole cu vârful în origine",
      "caption": "Figura 1"
    },
    {
      "id": "block-pdf",
      "schemaVersion": 1,
      "type": "pdf_reference",
      "locale": "ro-RO",
      "assetId": "asset-formula-sheet",
      "accessibleLabel": "Fișă de formule, paginile 2 și 3",
      "pageRange": {
        "start": 2,
        "end": 3
      }
    },
    {
      "id": "block-audio",
      "schemaVersion": 1,
      "type": "audio",
      "locale": "ro-RO",
      "assetId": "asset-audio-instructions",
      "accessibleLabel": "Instrucțiuni audio",
      "transcriptAssetId": "asset-audio-instructions-transcript"
    },
    {
      "id": "block-video",
      "schemaVersion": 1,
      "type": "video",
      "locale": "ro-RO",
      "assetId": "asset-motion-demo",
      "accessibleLabel": "Demonstrație video a mișcării",
      "captionsAssetId": "asset-motion-demo-captions"
    },
    {
      "id": "block-callout",
      "schemaVersion": 1,
      "type": "callout",
      "locale": "ro-RO",
      "tone": "note",
      "title": "Notă",
      "text": "Poți folosi instrumentul de geometrie inclus."
    },
    {
      "id": "block-code",
      "schemaVersion": 1,
      "type": "code",
      "locale": "ro-RO",
      "code": "f = lambda x: x ** 2",
      "language": "python",
      "accessibleLabel": "Definiția funcției în Python"
    },
    {
      "id": "block-shared-stimulus",
      "schemaVersion": 1,
      "type": "shared_stimulus_reference",
      "locale": "ro-RO",
      "stimulusId": "stimulus-parabola-context",
      "stimulusVersion": 2
    },
    {
      "id": "block-tool-starter",
      "schemaVersion": 1,
      "type": "tool_starter",
      "locale": "ro-RO",
      "toolKey": "geometry-lab",
      "snapshotAssetId": "asset-geometry-starter-snapshot",
      "accessibleLabel": "Construcție inițială în laboratorul de geometrie"
    },
    {
      "id": "block-rule",
      "schemaVersion": 1,
      "type": "horizontal_rule",
      "locale": "ro-RO"
    }
  ],
  "interactions": [
    {
      "id": "interaction-single",
      "schemaVersion": 1,
      "type": "choice_single",
      "required": true,
      "contentBlockIds": [
        "block-paragraph"
      ],
      "options": [
        {
          "id": "option-a",
          "label": "Graficul este o dreaptă."
        },
        {
          "id": "option-b",
          "label": "Graficul este o parabolă.",
          "accessibleLabel": "Opțiunea B: graficul este o parabolă"
        }
      ],
      "shuffle": false
    },
    {
      "id": "interaction-multiple",
      "schemaVersion": 1,
      "type": "choice_multiple",
      "required": true,
      "contentBlockIds": [
        "block-list",
        "block-table"
      ],
      "options": [
        {
          "id": "statement-a",
          "label": "f(0)=0"
        },
        {
          "id": "statement-b",
          "label": "f(2)=4"
        },
        {
          "id": "statement-c",
          "label": "f(2)=2"
        }
      ],
      "shuffle": true,
      "minSelections": 1,
      "maxSelections": 2
    },
    {
      "id": "interaction-boolean",
      "schemaVersion": 1,
      "type": "boolean",
      "required": true,
      "contentBlockIds": [
        "block-heading"
      ],
      "trueLabel": "Adevărat",
      "falseLabel": "Fals"
    },
    {
      "id": "interaction-short",
      "schemaVersion": 1,
      "type": "short_text",
      "required": false,
      "contentBlockIds": [
        "block-inline-math"
      ],
      "maxLength": 120
    },
    {
      "id": "interaction-numeric",
      "schemaVersion": 1,
      "type": "numeric",
      "required": true,
      "contentBlockIds": [
        "block-display-math"
      ],
      "allowDecimal": true,
      "allowNegative": false,
      "unitMode": "optional",
      "allowedUnits": [
        "m",
        "cm"
      ]
    },
    {
      "id": "interaction-math-expression",
      "schemaVersion": 1,
      "type": "math_expression",
      "required": true,
      "contentBlockIds": [
        "block-inline-math",
        "block-code"
      ],
      "entryMode": "both",
      "maxLength": 500
    },
    {
      "id": "interaction-extended",
      "schemaVersion": 1,
      "type": "extended_text",
      "required": true,
      "contentBlockIds": [
        "block-pdf",
        "block-shared-stimulus"
      ],
      "maxLength": 4000,
      "format": "plain_text"
    },
    {
      "id": "interaction-photo",
      "schemaVersion": 1,
      "type": "file_photo",
      "required": false,
      "contentBlockIds": [
        "block-image",
        "block-tool-starter"
      ],
      "maxFiles": 4,
      "maxBytesPerFile": 10485760,
      "acceptedMediaTypes": [
        "image/jpeg",
        "image/png",
        "image/webp"
      ]
    },
    {
      "id": "interaction-tool-snapshot",
      "schemaVersion": 1,
      "type": "tool_snapshot",
      "required": true,
      "contentBlockIds": [
        "block-tool-starter"
      ],
      "toolKey": "geometry-lab",
      "starterSnapshotAssetId": "asset-geometry-starter-snapshot",
      "readOnlyStarter": false
    },
    {
      "id": "interaction-composite",
      "schemaVersion": 1,
      "type": "composite",
      "required": true,
      "contentBlockIds": [
        "block-callout",
        "block-rule"
      ],
      "childInteractionIds": [
        "interaction-numeric",
        "interaction-photo",
        "interaction-tool-snapshot"
      ]
    }
  ],
  "deliveryContext": {
    "kind": "assessment_delivery_context",
    "schemaVersion": 1,
    "opportunityRole": "summative_measurement",
    "stakes": "medium",
    "supervision": "in_person",
    "resourcePolicy": "limited",
    "collaborationMode": "independent",
    "environment": "casa_exam_room",
    "learningTransitionAllowed": false
  }
}
